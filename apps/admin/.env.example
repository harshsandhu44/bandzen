# Supabase — the same project and database as apps/app. `pnpm db:start` prints
# these; the local stack's values are the same on every machine.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Comma-separated emails treated as admin regardless of profiles.role.
# This is how the very first admin bootstraps themselves (there is no one
# else to grant them the role via the /teachers screen), and it stays set
# permanently afterward as break-glass access if publicMetadata is ever
# cleared or wiped.
ADMIN_EMAILS=

# Speaking + Listening CMS generation. The /listening and /speaking edit pages
# synthesize examiner/track audio on demand (ElevenLabs), transcribe uploaded
# audio (OpenAI Whisper), and upload the results to Cloudflare R2. Same values
# as apps/app.
OPENAI_API_KEY=
# Optional override for the content-generation model (default gpt-5.5).
OPENAI_CONTENT_MODEL=
# Optional override for the transcription model (default whisper-1).
TRANSCRIBE_MODEL=
ELEVENLABS_API_KEY=
# ElevenLabs premade voice id for the examiner/narrator. Optional — defaults to
# Rachel (21m00Tcm4TlvDq8ikWAM).
ELEVENLABS_VOICE_ID=

# R2 — Cloudflare dashboard → R2 → Manage API tokens, scoped to this bucket.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# The student app's origin, for the "Preview as student" link on every editor.
NEXT_PUBLIC_APP_URL=http://localhost:3002
