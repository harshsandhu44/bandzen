# Where this site's CTAs send people. /app is served by this app via a rewrite,
# so it is this origin plus /app -- not the product app's own port or host.
NEXT_PUBLIC_APP_URL=http://localhost:3000/app

# Where /app is proxied to. Leave unset in production: next.config.ts then
# defaults to the product app's own deployment. Locally it must point at the
# app's dev server, or /app proxies to production and you appear signed out.
NEXT_PUBLIC_APP_ORIGIN=http://localhost:3002
