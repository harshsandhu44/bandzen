# The product app, which the marketing CTAs point at. Unset falls back to
# https://app.bandzen.com; set it to http://localhost:3002 to work against
# apps/app locally.
NEXT_PUBLIC_APP_URL=

# The docs deployment that /docs is rewritten to. This is a Vercel project
# origin rather than a public URL — nobody visits it directly, and
# docs.bandzen.com is deliberately never assigned.
#
# Read at build time, so a change needs a web redeploy. A docs deploy does not:
# the origin stays the same. Set it to http://localhost:3001 to proxy a local
# docs server.
NEXT_PUBLIC_DOCS_ORIGIN=

# This site's own origin, used by robots.txt and sitemap.xml. Unset falls back
# to https://bandzen.com.
NEXT_PUBLIC_SITE_URL=
