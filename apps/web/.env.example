# The product app, which every marketing CTA points at. Unset falls back to
# https://app.bandzen.com; set it to http://localhost:3002 to work against
# apps/app locally.
NEXT_PUBLIC_APP_URL=

# The documentation, linked from the footer. Unset falls back to
# https://docs.bandzen.com; set it to http://localhost:3001 for apps/docs.
NEXT_PUBLIC_DOCS_URL=

# This site's own origin, used by robots.txt and sitemap.xml to build absolute
# URLs. Unset falls back to https://bandzen.com.
NEXT_PUBLIC_SITE_URL=

# PostHog project token. Public by design — it is what browser SDKs ship. Unset
# means analytics no-ops entirely, so a green build is not proof this is
# configured; check the Vercel project. NEXT_PUBLIC_ values are baked into the
# client bundle, so changing it needs a redeploy, not just a save.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=

# PostHog ingestion host. Unset falls back to https://us.i.posthog.com.
NEXT_PUBLIC_POSTHOG_HOST=
