# Neon — the pooled connection string from the Neon dashboard
DATABASE_URL=postgresql://<user>:<password>@<host>/<db>?sslmode=require

# Clerk — Dashboard → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Sign-up is open in the Clerk dashboard (Restrictions → Sign-up mode →
# Public) — nothing to configure here.

NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/signup

# Essay grading, Speaking grading, Bandzen Coach, and offline content
# generation (scripts/generate-*.mts).
OPENAI_API_KEY=

# Optional model overrides — defaults live in src/lib/ai/models.ts and
# packages/ai/src/speech.ts. OPENAI_SPEAKING_GRADER_MODEL must be an
# audio-input model (default: gpt-audio-mini).
# OPENAI_GRADER_MODEL=
# OPENAI_COACH_MODEL=
# OPENAI_CONTENT_MODEL=
# OPENAI_SPEAKING_GRADER_MODEL=

# Listening + Speaking audio. ElevenLabs synthesizes offline-generated
# transcripts and examiner prompts;
# Cloudflare R2 stores the resulting MP3s. Both only ever run from
# scripts/synthesize-listening-audio.mts, never from a request.
ELEVENLABS_API_KEY=

# R2 — Cloudflare dashboard → R2 → Manage API tokens, scoped to this bucket.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# The bucket's public base URL — either its r2.dev subdomain (R2 → bucket →
# Settings → Public access) or a custom domain mapped to it.
R2_PUBLIC_URL=

# Polar — Dashboard → Settings → Developers → Organization Access Tokens.
# Polar is the Merchant of Record: it sells to the candidate, collects the tax
# and pays us out. Both of these are server-only and must never be prefixed
# NEXT_PUBLIC_ — the access token can create checkouts and read customers.
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=

# `sandbox` or `production`. Anything else is read as sandbox, deliberately:
# an unset variable must not quietly start charging real cards.
POLAR_SERVER=sandbox

# The two products, from their dashboard URLs. Sandbox and production have
# different ids. Each is priced in all four currencies; quarterly is a monthly
# interval with a count of 3.
POLAR_PRODUCT_MONTHLY=
POLAR_PRODUCT_QUARTERLY=

# The founding price is not an environment variable. It is two Polar discounts
# coded FOUNDINGMONTHLY and FOUNDINGQUARTERLY — fixed amounts, in INR only,
# each restricted to its product, both carrying the same `ends_at`. The app
# reads their ids and their deadline from the same call it reads prices with,
# so what is advertised and what is charged cannot come from different places.
# A discount with no end date is ignored: the offer is defined by having one.
# The two codes are matched as exact strings. A typo in the dashboard does not
# error — the founding offer just silently never appears, and everyone is
# quoted the standard price.

# PostHog. Capture is server-side only, so the project token is all that is
# needed — it is NEXT_PUBLIC_ because a project token is public by design and
# one name then serves client-side capture too, if that is ever added.
# Unset disables analytics entirely: no events are sent and nothing errors.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# The documentation site, linked from the sidebar and Settings. Unset falls
# back to https://docs.bandzen.com; set it to http://localhost:3001 to work
# against apps/docs locally.
NEXT_PUBLIC_DOCS_URL=

# Sentry — sentry.io project → Settings → Client Keys (DSN). Same DSN in both;
# NEXT_PUBLIC_ is needed for browser-side capture. Unset disables reporting
# entirely: init() no-ops and nothing errors.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
