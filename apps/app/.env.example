# Neon — the pooled connection string from the Neon dashboard
DATABASE_URL=postgresql://<user>:<password>@<host>/<db>?sslmode=require

# Clerk — Dashboard → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Set the beta gate in the Clerk dashboard: Restrictions → Sign-up mode →
# Restricted, then invite people from Configure → Invitations. There is no
# invite table in this app; Clerk is the gate.

NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/signup

# Where apps/web sends users.
NEXT_PUBLIC_SITE_URL=http://localhost:3002

# Essay grading.
OPENAI_API_KEY=
