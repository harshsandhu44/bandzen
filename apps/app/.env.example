# Neon — the pooled connection string from the Neon dashboard
DATABASE_URL=postgresql://<user>:<password>@<host>/<db>?sslmode=require

# Clerk — Dashboard → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Set the beta gate in the Clerk dashboard: Restrictions → Sign-up mode →
# Restricted, then invite people from Configure → Invitations. There is no
# invite table in this app; Clerk is the gate.

NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/signup

# Essay grading, Speaking grading, Bandzen Coach, and offline content
# generation (scripts/generate-*.mts).
OPENAI_API_KEY=

# Optional model overrides — defaults live in src/lib/ai/models.ts and
# packages/ai/src/speech.ts. OPENAI_SPEAKING_GRADER_MODEL must be an
# audio-input model (default: gpt-audio-mini).
# OPENAI_GRADER_MODEL=
# OPENAI_CONTENT_MODEL=
# OPENAI_SPEAKING_GRADER_MODEL=

# Listening + Speaking audio. ElevenLabs synthesizes offline-generated
# transcripts and examiner prompts;
# Cloudflare R2 stores the resulting MP3s. Both only ever run from
# scripts/synthesize-listening-audio.mts, never from a request.
ELEVENLABS_API_KEY=

# R2 — Cloudflare dashboard → R2 → Manage API tokens, scoped to this bucket.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# The bucket's public base URL — either its r2.dev subdomain (R2 → bucket →
# Settings → Public access) or a custom domain mapped to it.
R2_PUBLIC_URL=

# Razorpay — Dashboard → Account & Settings → API Keys.
# The publishable id is needed in the browser to open Checkout; the secret and
# the webhook secret are server-only and must never be prefixed NEXT_PUBLIC_.
RAZORPAY_KEY_ID=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# A Razorpay plan's amount is fixed when the plan is created, so the founding
# price and the standard price are four separate plans rather than two. Create
# them under Subscriptions → Plans; test and live mode have different ids.
RAZORPAY_PLAN_FOUNDING_MONTHLY=
RAZORPAY_PLAN_FOUNDING_QUARTERLY=
RAZORPAY_PLAN_STANDARD_MONTHLY=
RAZORPAY_PLAN_STANDARD_QUARTERLY=

# Decided: 31 October 2026. Set this in Vercel's production environment, or
# apps/web advertises the founding price while /upgrade charges the standard one.
# When the founding price stops. An ISO date; unset means the window is closed
# and everyone pays the standard price. The price must actually rise when this
# passes — a deadline that keeps moving is the fake-urgency pattern we do not use.
FOUNDING_ENDS_AT=

# PostHog. Capture is server-side only, so the project token is all that is
# needed — it is NEXT_PUBLIC_ because a project token is public by design and
# one name then serves client-side capture too, if that is ever added.
# Unset disables analytics entirely: no events are sent and nothing errors.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# The documentation site, linked from the sidebar and Settings. Unset falls
# back to https://docs.bandzen.com; set it to http://localhost:3001 to work
# against apps/docs locally.
NEXT_PUBLIC_DOCS_URL=
