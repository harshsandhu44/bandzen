# Neon — the pooled connection string from the Neon dashboard
DATABASE_URL=postgresql://<user>:<password>@<host>/<db>?sslmode=require

# Clerk — Dashboard → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Set the beta gate in the Clerk dashboard: Restrictions → Sign-up mode →
# Restricted, then invite people from Configure → Invitations. There is no
# invite table in this app; Clerk is the gate.

NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/signup

# Where apps/web sends users.
NEXT_PUBLIC_SITE_URL=http://localhost:3002

# Essay grading.
OPENAI_API_KEY=

# Razorpay — Dashboard → Account & Settings → API Keys.
# The publishable id is needed in the browser to open Checkout; the secret and
# the webhook secret are server-only and must never be prefixed NEXT_PUBLIC_.
RAZORPAY_KEY_ID=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# A Razorpay plan's amount is fixed when the plan is created, so the founding
# price and the standard price are four separate plans rather than two. Create
# them under Subscriptions → Plans; test and live mode have different ids.
RAZORPAY_PLAN_FOUNDING_MONTHLY=
RAZORPAY_PLAN_FOUNDING_QUARTERLY=
RAZORPAY_PLAN_STANDARD_MONTHLY=
RAZORPAY_PLAN_STANDARD_QUARTERLY=

# TODO: decide the founding window before launch.
# When the founding price stops. An ISO date; unset means the window is closed
# and everyone pays the standard price. The price must actually rise when this
# passes — a deadline that keeps moving is the fake-urgency pattern we do not use.
FOUNDING_ENDS_AT=

# TODO: add the PostHog project token when you want conversion data.
# Server-side capture only, so the project token is all that is needed.
# Unset disables analytics entirely — no events are sent and nothing errors.
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com
